# Beispiel-Konfiguration für Fetchbridge (fetchbridge.py)
#
# Standardpfad: /etc/fetchbridge/fetchbridge.conf
# Zusätzlich wird ein Verzeichnis /etc/fetchbridge/conf.d/*.conf eingelesen
# (alphabetisch, spätere Dateien überschreiben frühere Werte). Beide Pfade
# lassen sich per ENV überschreiben: CONFIG_FILE, CONF_D_DIR.
#
# Änderungen an dieser Datei werden im laufenden Betrieb automatisch
# erkannt (Prüfung alle CONFIG_CHECK_INTERVAL Sekunden per MD5-Hash) und
# angewendet - außer bei source_dir, das einen Neustart erfordert.

[general]
# Log-Level: DEBUG, INFO, WARNING, ERROR
# log_level = INFO
# Alternative dazu: die Umgebungsvariable DEBUG=true/yes/1 (wie bei
# tw-recorder/yt-upload) - siehe README, keine Config-Option.

# Fester Pfad für die rotierende Logdatei (max. 10 MB, 5 Backups). Ohne
# diese Angabe wird automatisch geloggt, sobald /log tatsächlich als
# Docker-Volume gemountet ist (reines Vorhandensein des Verzeichnisses
# reicht nicht - das Dockerfile legt es auch ganz ohne Mount an) oder ein
# klassischer Syslog-Daemon läuft - sonst nur nach stdout (journald/docker
# logs erfassen das bereits).
# log_file = /log/fetchbridge.log

# Quellverzeichnis, das überwacht wird (Änderung erfordert Neustart des
# Fetchbridge-Prozesses, da InotifyTree fest an den Startpfad gebunden ist)
# source_dir = /srv/media-pipeline/recordings

# Zielverzeichnis, in das fertige Dateien verschoben/kopiert werden
# target_dir = /srv/media-pipeline/incoming


[mover]
# Kommagetrennte Liste erlaubter Datei-Endungen
# allowed_extensions = .mkv,.mp4,.webm

# Kommagetrennte Liste von Endungen, die als "noch nicht fertig" gelten
# und ignoriert werden
# temp_extensions = .part,.ytdl,.tmp,.temp

# Bevor eine Datei verschoben/kopiert wird, prüft fetchbridge per
# Dateigrößenvergleich, ob sie noch von einem anderen Prozess beschrieben
# wird (Absicherung zusätzlich zum IN_CLOSE_WRITE-Event, z.B. gegen
# Flush-Close-Reopen-Verhalten oder verzögerte Events auf Netzwerk-Mounts).
# stability_check_interval = 2
# stability_max_checks = 10
