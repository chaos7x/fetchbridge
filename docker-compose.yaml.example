services:
  fetchbridge:
    image: ghcr.io/chaos7x/fetchbridge:${IMAGE_VERSION:-latest}
    container_name: fetchbridge
    hostname: fetchbridge
    user: "11107:11108"
    restart: unless-stopped
    environment:
      - TZ=Europe/Berlin
      - PYTHONUNBUFFERED=1
      - HOME=/tmp
    env_file:
      - .env

# ==========================================
# Healthcheck-Override (optional) - im Image ist bereits eine HEALTHCHECK-
# Instruktion hinterlegt, hier nur relevant für andere Intervalle/Timeouts.
# ==========================================
#    healthcheck:
#      test: ["CMD", "fetchbridge", "--healthcheck"]
#      interval: 30s
#      timeout: 5s
#      start_period: 15s
#      retries: 3
    volumes:
      # Optionales App-Volume (bei Bedarf einkommentieren)
      # - app:/app:ro
      # Eingangs-Ordner aus dem streamlink-recorder
      - storage-source:/srv/media-pipeline/recordings:rw
      # Ausgangs-Ordner für den yt-upload
      - storage-target:/srv/media-pipeline/incoming:rw

# ==========================================
# SEPARATE VOLUMES DEKLARATION
# ==========================================
volumes:
  # --- App Volume (für externe fetchbridge.py / Skripte) ---
  app:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: ./app

  # --- Bind Mounts für Daten ---
  storage-source:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker/tw-recorder/recordings

  # Zeigt bewusst auf die "in"-Unterordner von yt-uploads eigenem
  # yt-upload-data-Bind-Mount (siehe dessen docker-compose.yaml.example)
  # statt auf ein eigenes Top-Level-Verzeichnis - spart yt-upload dadurch
  # einen zweiten Bind-Mount, ohne dass fetchbridge etwas anders mounten muss.
  storage-target:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker/yt-upload/yt-upload-data/in

  # --- Vorbereitung für spätere NFS-Mounts ---
  # storage-source:
  #   driver: local
  #   driver_opts:
  #     type: nfs
  #     o: addr=192.168.1.100,rw,nolock,hard,nfsvers=4
  #     device: ":/volume1/recordings"
  #
  # storage-target:
  #   driver: local
  #   driver_opts:
  #     type: nfs
  #     o: addr=192.168.1.100,rw,nolock,hard,nfsvers=4
  #     device: ":/volume1/yt-upload-data/in"
