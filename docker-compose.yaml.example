services:
  fetchbridge:
    image: ghcr.io/chaos7x/fetchbridge:${IMAGE_VERSION:-latest}
    container_name: fetchbridge
    hostname: fetchbridge
    user: "11107:11108"
    restart: unless-stopped
    environment:
      - TZ=Europe/Berlin
      - PYTHONUNBUFFERED=1
      - HOME=/tmp
    env_file:
      - .env

# ==========================================
# Healthcheck-Override (optional) - im Image ist bereits eine HEALTHCHECK-
# Instruktion hinterlegt, hier nur relevant für andere Intervalle/Timeouts.
# ==========================================
#    healthcheck:
#      test: ["CMD", "fetchbridge", "--healthcheck"]
#      interval: 30s
#      timeout: 5s
#      start_period: 15s
#      retries: 3
    volumes:
      # Optionales App-Volume (bei Bedarf einkommentieren)
      # - app:/app:ro
      # EIN gemeinsamer Bind-Mount für recordings/ UND incoming/ statt zwei
      # getrennter Mounts: os.rename() (mover._move_file()) scheitert mit
      # EXDEV, sobald Quelle und Ziel über unterschiedliche Bind-Mounts
      # eingehängt sind - und zwar UNABHÄNGIG davon, ob die zugrundeliegenden
      # Host-Verzeichnisse auf derselben Partition liegen. Der Grund: der
      # Kernel prüft bei rename() auf dieselbe Mount-Instanz, nicht nur auf
      # dasselbe Dateisystem/denselben st_dev - zwei separate `mount --bind`
      # derselben Partition an unterschiedlichen Pfaden zählen für rename()
      # trotzdem als "unterschiedliche Mounts" (empirisch verifiziert). Mit
      # zwei Volumes fällt fetchbridge deshalb bei JEDEM Verschieben auf den
      # langsameren Kopieren+Löschen-Fallback zurück, statt den atomaren
      # Rename zu nutzen - bei mehrstündigen Aufnahmen ein echter
      # Zeit-/IO-Unterschied. Setzt voraus, dass tw-recorder und yt-upload
      # ihrerseits auf denselben Host-Baum zeigen (siehe deren jeweilige
      # docker-compose.yaml.example).
      - storage:/srv/media-pipeline:rw

# ==========================================
# SEPARATE VOLUMES DEKLARATION
# ==========================================
volumes:
  # --- App Volume (für externe fetchbridge.py / Skripte) ---
  app:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: ./app

  # --- Bind Mount für Daten ---
  # Gemeinsamer Host-Baum für die gesamte Pipeline (recordings/, incoming/,
  # sowie yt-uploads eigene work/done/corrupt/retry-Unterordner) - derselbe
  # Pfad, den auch tw-recorder (nur recordings/) und yt-upload (der ganze
  # Baum, siehe dessen docker-compose.yaml.example) einbinden. Migration von
  # einem bestehenden Setup mit getrennten storage-source/storage-target-
  # Verzeichnissen: deren Inhalte einmalig in diesen gemeinsamen Baum
  # verschieben, bevor der Container neu gestartet wird.
  storage:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker/media-pipeline

  # --- Vorbereitung für spätere NFS-Mounts ---
  # Auch hier EIN gemeinsamer Mount für den ganzen Baum statt zwei separater
  # NFS-Exports, aus demselben Grund wie oben.
  # storage:
  #   driver: local
  #   driver_opts:
  #     type: nfs
  #     o: addr=192.168.1.100,rw,nolock,hard,nfsvers=4
  #     device: ":/volume1/media-pipeline"
