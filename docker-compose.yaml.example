services:
  fetchbridge:
    image: ghcr.io/chaos7x/fetchbridge:${IMAGE_VERSION:-latest}
    container_name: fetchbridge
    hostname: fetchbridge
    user: "11107:11108"
    restart: unless-stopped
    environment:
      - TZ=Europe/Berlin
      - PYTHONUNBUFFERED=1
      - HOME=/tmp
    env_file:
      - .env

# ==========================================
# Healthcheck, muss seperat altiviert werden, wenn fetchbridge sich unter /app befindet
# ==========================================
#    healthcheck:
#      test: ["CMD", "python3", "/app/fetchbridge", "--healthcheck"]
#      interval: 30s
#      timeout: 5s
#      start_period: 15s
#
      retries: 3
    volumes:
      # Optionales App-Volume (bei Bedarf einkommentieren)
      # - app:/app:ro
      # Eingangs-Ordner aus dem streamlink-recorder
      - storage-source:/media/out:rw
      # Ausgangs-Ordner für den yt-upload
      - storage-target:/media/in:rw

# ==========================================
# SEPARATE VOLUMES DEKLARATION
# ==========================================
volumes:
  # --- App Volume (für externe fetchbridge.py / Skripte) ---
  app:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: ./app

  # --- Bind Mounts für Daten ---
  storage-source:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker/tw-recorder/videos

  storage-target:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker/yt-upload/videos/in

  # --- Vorbereitung für spätere NFS-Mounts ---
  # storage-source:
  #   driver: local
  #   driver_opts:
  #     type: nfs
  #     o: addr=192.168.1.100,rw,nolock,hard,nfsvers=4
  #     device: ":/volume1/recordings/in"
  #
  # storage-target:
  #   driver: local
  #   driver_opts:
  #     type: nfs
  #     o: addr=192.168.1.100,rw,nolock,hard,nfsvers=4
  #     device: ":/volume1/recordings/out"
