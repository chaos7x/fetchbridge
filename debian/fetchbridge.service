[Unit]
Description=fetchbridge - Inotify-basierte Bridge zwischen Verzeichnissen
Documentation=https://github.com/chaos7x/fetchbridge
After=network.target local-fs.target

[Service]
Type=simple
User=fetchbridge
Group=fetchbridge
SupplementaryGroups=media-pipeline
ExecStart=/usr/bin/fetchbridge -D
Restart=on-failure
RestartSec=5

# --- Hardening ---
# ReadWritePaths gibt den gemeinsamen Baum /srv/media-pipeline als EINEN
# Eintrag frei statt SOURCE_DIR und TARGET_DIR einzeln: ProtectSystem=strict
# setzt jeden ReadWritePaths-Eintrag als eigenen Bind-Mount im Mount-Namespace
# des Dienstes um, und rename() zwischen zwei verschiedenen Mounts liefert
# unter Linux EXDEV (errno 18) - auch wenn beide auf derselben Partition
# liegen. Mit getrennten Eintraegen fiel mover._move_file() deshalb bei JEDER
# Datei von recordings nach incoming auf Kopieren+Loeschen zurueck.
# Den Blast-Radius begrenzt stattdessen ReadOnlyPaths auf yt-uploads
# Arbeitsverzeichnisse (work/done/corrupt/retry), die fetchbridge nie
# beschreibt; das "-" ignoriert noch nicht angelegte Verzeichnisse. Ein
# ReadOnlyPaths-Unterverzeichnis stoert rename() zwischen recordings und
# incoming nicht, weil beide weiterhin auf demselben Mount liegen.
# /var/log/fetchbridge ist der Standard-Logpfad (siehe
# logging_setup._resolve_log_file_path()). Wer abweichende Pfade konfiguriert
# (LOG_FILE/SOURCE_DIR/TARGET_DIR/...), muss sie hier ergaenzen - SOURCE_DIR
# und TARGET_DIR dabei moeglichst ueber ein gemeinsames Elternverzeichnis,
# sonst kommt der EXDEV-Fallback zurueck.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/media-pipeline /var/log/fetchbridge
ReadOnlyPaths=-/srv/media-pipeline/work -/srv/media-pipeline/done -/srv/media-pipeline/corrupt -/srv/media-pipeline/retry
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
# fetchbridge macht ueberhaupt keine Netzwerk-Aufrufe (reine lokale
# Dateiverschiebung, ctypes-basiertes inotify ohne Socket) - daher werden
# saemtliche Adressfamilien blockiert statt nur auf TCP/IP eingeschraenkt.
RestrictAddressFamilies=none

[Install]
WantedBy=multi-user.target
